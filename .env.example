# Django General Settings
DJANGO_SECRET_KEY=django-insecure-pec-hr-dev-secret-key-change-in-production!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=volunteer_coordination_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS (Frontend / React Native Metro bundler)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# Security & Crypto Secrets (HMAC for phone hashes as defined in schema v0.5)
PHONE_HASH_HMAC_SECRET=replace-with-a-secure-secret-key-for-hmac

