# Django & Runtime Settings (injected via root config_di.py)
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=<generate-64-char-random-secret>
DJANGO_SECRET_KEY=<generate-64-char-random-secret>
ALLOWED_HOSTS=localhost,127.0.0.1

# Consumer-Only / Developer Options Toggle
# false = Consumer-only UI & error masking (recommended); true = Show developer diagnostics
VCS_DEV_OPTIONS_ENABLED=false
ALLOW_DEV_CODE_IN_AUTH_RESPONSE=false

# Cryptographic Keys (supply distinct high-entropy values outside VCS repository)
PHONE_HASH_HMAC_SECRET=<generate-64-char-random-secret>
OTP_CODE_HMAC_SECRET=<generate-64-char-distinct-hmac-secret>
AUTH_SESSION_TOKEN_SECRET=<generate-64-char-distinct-session-secret>
PHONE_ENCRYPTION_KEY=<generate-32-byte-urlsafe-base64-fernet-key>

# Verification Image Encryption (AES-256-GCM - strictly distinct from all other keys)
VERIFICATION_IMAGE_ENCRYPTION_KEY=<generate-32-byte-urlsafe-base64-aes256-key>
VERIFICATION_IMAGE_KEY_ID=v1
VERIFICATION_IMAGE_KEYRING={"v1":"<generate-32-byte-urlsafe-base64-aes256-key>"}

# PostgreSQL Database Configuration
DB_NAME=volunteer_coordination_db
DB_USER=postgres
DB_PASSWORD=<set-local-postgres-password>
DB_HOST=127.0.0.1
DB_PORT=5432

# Map Engine & Tile Server
CARTO_API_KEY=<optional-carto-api-key>

# Read-only AI assistant: choose exactly one provider (mock | ollama | gemini)
AI_ENABLED=true
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:4b
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=600
AI_RATE_LIMIT_PER_MINUTE=20
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_KEEP_ALIVE=5m
# For Gemini instead: AI_PROVIDER=gemini, AI_MODEL=gemini-3.5-flash-lite,
# and set AI_API_KEY in local untracked .env or di_config.local.json. Never commit an API key.
